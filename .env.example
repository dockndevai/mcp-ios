# --- Connection -------------------------------------------------------------
# Base URL of the running Appium server (XCUITest / WebDriverAgent).
IOS_APPIUM_URL=http://127.0.0.1:4723
# Target device UDID (from `xcrun xctrace list devices` or `idevice_id -l`).
# Empty = Appium's default device.
# IOS_UDID=
# Optional default app bundle ID to attach the session to.
# IOS_BUNDLE_ID=
# Session / new-command timeout (ms).
IOS_TIMEOUT_MS=60000

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
IOS_MODE=read-only
# Comma-separated bundle-ID allowlist. Empty = all apps.
IOS_APP_ALLOWLIST=
# Apps that can be inspected/launched but never terminated, reset, or uninstalled.
IOS_PROTECTED_APPS=com.apple.Preferences,com.apple.springboard
# install_app / terminate_app / reset_app require this in addition to admin mode.
IOS_ALLOW_MANAGE=false
# Validate + log write/admin actions without executing them on the device.
IOS_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
IOS_AUDIT_LOG=true
