{
  "name": "@dockndevai/mcp-ios",
  "mcpName": "io.github.dockndevai/mcp-ios",
  "version": "0.1.0",
  "description": "Model Context Protocol server to drive a physical iPhone/iPad over Appium + WebDriverAgent (XCUITest) — screenshots, taps, typing, swipes, app launch, Shortcuts — safe-by-default with access modes and gated destructive ops.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockndevai/mcp-ios.git"
  },
  "bugs": {
    "url": "https://github.com/dockndevai/mcp-ios/issues"
  },
  "homepage": "https://github.com/dockndevai/mcp-ios#readme",
  "bin": {
    "mcp-ios": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ios",
    "appium",
    "webdriveragent",
    "xcuitest",
    "device-control",
    "mobile",
    "llm",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "webdriverio": "^10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
